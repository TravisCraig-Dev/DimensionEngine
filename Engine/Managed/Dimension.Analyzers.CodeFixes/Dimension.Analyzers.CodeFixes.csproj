<Project Sdk="Microsoft.NET.Sdk">
  <!-- Quick fixes for Dimension.Analyzers' warnings (the IDE offers them). netstandard2.0 against Roslyn 4.8, as the
       analyzers. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <NoWarn>RS1036;RS2008;RS1041;RS1038</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Dimension.Analyzers\Dimension.Analyzers.csproj" Private="false" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
