<Project Sdk="Microsoft.NET.Sdk">
  <!-- Roslyn analyzers for game scripts (engine-specific warnings in the IDE and the editor's Console). netstandard2.0
       against Roslyn 4.8, so every host loads them: dotnet build, Rider and Visual Studio 2022 or later. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <NoWarn>RS1036;RS2008;RS1041</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
