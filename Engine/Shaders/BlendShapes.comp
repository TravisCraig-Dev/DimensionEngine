#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

// Blend shapes on the GPU: one invocation per vertex adds the weighted shapes' position and normal deltas to the
// model's vertex and writes it to the frame's vertex stream (skinning then applies on top, in the vertex shader).
// Vertices are 13 words (position, normal, UV, tangent floats and the RGBA8 color: the C++ Vertex, tightly packed; read
// as words so the color's bits pass through untouched); the deltas are two vec4 per
// vertex per shape (position, normal), shape by shape; the list holds (shape index, weight bits) pairs.
layout(local_size_x = 64) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer VerticesIn { uint U[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer VerticesOut { uint U[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Deltas { vec4 D[]; };
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer ShapeList { uvec2 S[]; };

layout(push_constant) uniform Push
{
    uvec2 Base, Delta, Out, List;
    uint VertexCount, ShapeCount;
} uPush;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uPush.VertexCount) return;
    VerticesIn base = VerticesIn(uPush.Base);
    uint o = i * 13u;
    vec3 p = uintBitsToFloat(uvec3(base.U[o], base.U[o + 1u], base.U[o + 2u]));
    vec3 n = uintBitsToFloat(uvec3(base.U[o + 3u], base.U[o + 4u], base.U[o + 5u]));
    uvec2 uv = uvec2(base.U[o + 6u], base.U[o + 7u]);
    vec4 t = uintBitsToFloat(uvec4(base.U[o + 8u], base.U[o + 9u], base.U[o + 10u], base.U[o + 11u]));
    uint color = base.U[o + 12u];
    Deltas deltas = Deltas(uPush.Delta);
    ShapeList list = ShapeList(uPush.List);
    vec3 sum = n;
    for (uint k = 0u; k < uPush.ShapeCount; ++k)
    {
        uvec2 entry = list.S[k];
        float w = uintBitsToFloat(entry.y);
        uint at = (entry.x * uPush.VertexCount + i) * 2u;
        p += deltas.D[at].xyz * w;
        sum += deltas.D[at + 1u].xyz * w;
    }
    if (uPush.ShapeCount > 0u && dot(sum, sum) > 1e-12)
    {
        n = normalize(sum);
        vec3 tt = t.xyz - n * dot(n, t.xyz);
        if (t.w != 0.0 && dot(tt, tt) > 1e-12) t.xyz = normalize(tt);
    }
    VerticesOut outV = VerticesOut(uPush.Out);
    uvec3 pb = floatBitsToUint(p), nb = floatBitsToUint(n);
    uvec4 tb = floatBitsToUint(t);
    outV.U[o] = pb.x; outV.U[o + 1u] = pb.y; outV.U[o + 2u] = pb.z;
    outV.U[o + 3u] = nb.x; outV.U[o + 4u] = nb.y; outV.U[o + 5u] = nb.z;
    outV.U[o + 6u] = uv.x; outV.U[o + 7u] = uv.y;
    outV.U[o + 8u] = tb.x; outV.U[o + 9u] = tb.y; outV.U[o + 10u] = tb.z; outV.U[o + 11u] = tb.w;
    outV.U[o + 12u] = color;
}
