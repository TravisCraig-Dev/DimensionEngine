#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#include "ParticleCommon.glsl"

layout(set = 0, binding = 0) uniform sampler2D uTextures[];

// GPU particle simulation, one invocation per slot of a fixed-capacity ring. This frame's new particles take the
// slots from the ring head on (replacing the oldest); every other live particle is integrated. Mirrors the CPU
// simulation in ParticleSystem.cpp for the modules the GPU supports.
layout(local_size_x = 64) in;

layout(push_constant) uniform Push
{
    uvec2 Particles;
    uvec2 Params;
} pc;

const float TWO_PI = 6.28318530718;

uint g_Rng;
float Random01()
{
    // PCG hash step.
    g_Rng = g_Rng * 747796405u + 2891336453u;
    uint w = ((g_Rng >> ((g_Rng >> 28u) + 4u)) ^ g_Rng) * 277803737u;
    return float((w >> 22u) ^ w) * (1.0 / 4294967296.0);
}
float Range(vec2 r) { return r.x + (r.y - r.x) * Random01(); }

// Gradient noise and its curl, as ParticleSystems::GradientNoise / CurlNoise.
uint HashCell(ivec3 c)
{
    uint h = uint(c.x) * 0x8da6b343u ^ uint(c.y) * 0xd8163841u ^ uint(c.z) * 0xcb1ab31fu;
    h ^= h >> 15;
    h *= 0x2c1b3c6du;
    h ^= h >> 12;
    h *= 0x297a2d39u;
    return h ^ (h >> 15);
}

float GradDot(uint hash, vec3 d)
{
    switch (hash % 12u)
    {
    case 0u: return d.x + d.y;
    case 1u: return -d.x + d.y;
    case 2u: return d.x - d.y;
    case 3u: return -d.x - d.y;
    case 4u: return d.x + d.z;
    case 5u: return -d.x + d.z;
    case 6u: return d.x - d.z;
    case 7u: return -d.x - d.z;
    case 8u: return d.y + d.z;
    case 9u: return -d.y + d.z;
    case 10u: return d.y - d.z;
    default: return -d.y - d.z;
    }
}

float GradientNoise(vec3 p)
{
    vec3 cell = floor(p), f = p - cell;
    vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    ivec3 c = ivec3(cell);
    float c000 = GradDot(HashCell(c), f), c100 = GradDot(HashCell(c + ivec3(1, 0, 0)), f - vec3(1, 0, 0));
    float c010 = GradDot(HashCell(c + ivec3(0, 1, 0)), f - vec3(0, 1, 0)), c110 = GradDot(HashCell(c + ivec3(1, 1, 0)), f - vec3(1, 1, 0));
    float c001 = GradDot(HashCell(c + ivec3(0, 0, 1)), f - vec3(0, 0, 1)), c101 = GradDot(HashCell(c + ivec3(1, 0, 1)), f - vec3(1, 0, 1));
    float c011 = GradDot(HashCell(c + ivec3(0, 1, 1)), f - vec3(0, 1, 1)), c111 = GradDot(HashCell(c + ivec3(1, 1, 1)), f - vec3(1, 1, 1));
    float x00 = mix(c000, c100, u.x), x10 = mix(c010, c110, u.x), x01 = mix(c001, c101, u.x), x11 = mix(c011, c111, u.x);
    return mix(mix(x00, x10, u.y), mix(x01, x11, u.y), u.z);
}

vec3 Psi(vec3 q)
{
    return vec3(GradientNoise(q), GradientNoise(q + vec3(31.416, -47.853, 12.793)), GradientNoise(q + vec3(-73.219, 19.371, 58.111)));
}

vec3 CurlNoise(vec3 p)
{
    const float e = 0.05;
    vec3 dx = (Psi(p + vec3(e, 0, 0)) - Psi(p - vec3(e, 0, 0))) / (2.0 * e);
    vec3 dy = (Psi(p + vec3(0, e, 0)) - Psi(p - vec3(0, e, 0))) / (2.0 * e);
    vec3 dz = (Psi(p + vec3(0, 0, e)) - Psi(p - vec3(0, 0, e))) / (2.0 * e);
    return vec3(dy.z - dz.y, dz.x - dx.z, dx.y - dy.x) * 0.5;
}

GpuParticle Emit(GpuParticleParamsRef P, uint k)
{
    // Which emission segment this new particle belongs to (bursts at points, then the emitter itself).
    uint segment = 0u;
    for (uint s = 0u; s < PARTICLE_SEGMENTS; ++s)
    {
        uint n = P.SegmentCounts[s / 4u][s % 4u];
        if (k < n) { segment = s; break; }
        k -= n;
    }
    vec3 pos = vec3(0.0), dir = vec3(0.0, 1.0, 0.0);
    int shape = int(P.Shape.x + 0.5);
    if (shape == 0) // cone
    {
        float a = Random01() * TWO_PI;
        float r = sqrt(Random01()) * P.Shape.z;
        pos = vec3(cos(a) * r, 0.0, sin(a) * r);
        float spread = P.Shape.y * sqrt(Random01());
        float b = Random01() * TWO_PI;
        dir = vec3(sin(spread) * cos(b), cos(spread), sin(spread) * sin(b));
    }
    else if (shape == 1) // sphere
    {
        float z = Random01() * 2.0 - 1.0, a = Random01() * TWO_PI;
        float s = sqrt(max(0.0, 1.0 - z * z));
        dir = vec3(s * cos(a), z, s * sin(a));
        pos = dir * P.Shape.z * pow(Random01(), 1.0 / 3.0);
    }
    else if (shape == 2) // box
        pos = (vec3(Random01(), Random01(), Random01()) - 0.5) * P.Box.xyz;
    else if (shape == 4 && P.MeshSamples.z > 0u) // mesh surface, out along its normal
    {
        MeshSamplesRef samples = MeshSamplesRef(P.MeshSamples.xy);
        uint k = min(uint(Random01() * float(P.MeshSamples.z)), P.MeshSamples.z - 1u);
        pos = samples.Items[k * 2u].xyz;
        dir = samples.Items[k * 2u + 1u].xyz;
    }

    mat4 frame = P.Emitter;
    vec4 origin = P.SegmentOrigins[segment];
    bool atOrigin = origin.w > 0.5;
    if (atOrigin) frame[3] = vec4(origin.xyz, 1.0);
    float speed = Range(P.Lifetime.zw);
    vec3 worldPos = (frame * vec4(pos, 1.0)).xyz;
    GpuParticle p;
    if (P.Shape.w > 0.5)
    {
        vec3 d = mat3(frame) * dir;
        p.PosAge = vec4(worldPos, 0.0);
        p.VelLife.xyz = (length(d) > 1e-6 ? normalize(d) : dir) * speed;
    }
    else
    {
        p.PosAge = vec4(atOrigin ? (P.WorldToSim * vec4(worldPos, 1.0)).xyz : pos, 0.0);
        p.VelLife.xyz = dir * speed;
    }
    p.Color = mix(P.ColorA, P.ColorB, Random01());
    p.VelLife.w = max(0.01, Range(P.Lifetime.xy));
    p.Misc = vec4(Range(P.SizeRot.xy), Range(P.SizeRot.zw), Range(P.Spin.xy), P.Misc.z > 0.5 ? Random01() : 0.0);
    return p;
}

// The visible surface at a point of the last frame's depth buffer, in world space.
vec3 DepthWorld(GpuParticleParamsRef P, vec2 uv)
{
    float d = textureLod(uTextures[nonuniformEXT(P.DepthInfo.x)], uv, 0.0).r;
    vec4 w = P.DepthInvViewProj * vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, d, 1.0);
    return w.xyz / w.w;
}

// Collision with what the camera saw last frame: a particle just behind the visible surface bounces off it (along
// the surface normal rebuilt from the depth around it). Off screen, particles pass freely.
void DepthCollide(GpuParticleParamsRef P, inout GpuParticle p)
{
    if (P.DepthInfo.y == 0u) return;
    vec3 wp = (P.SimToWorld * vec4(p.PosAge.xyz, 1.0)).xyz;
    vec4 clip = P.DepthViewProj * vec4(wp, 1.0);
    if (clip.w <= 0.01) return;
    vec2 uv = vec2(clip.x / clip.w * 0.5 + 0.5, 0.5 - clip.y / clip.w * 0.5);
    if (any(lessThan(uv, vec2(0.002))) || any(greaterThan(uv, vec2(0.998)))) return;
    float d = textureLod(uTextures[nonuniformEXT(P.DepthInfo.x)], uv, 0.0).r;
    if (d >= 1.0) return; // sky
    vec3 surface = DepthWorld(P, uv);
    float surfaceW = (P.DepthViewProj * vec4(surface, 1.0)).w;
    float behind = clip.w - surfaceW + P.DepthParams.y;
    if (behind <= 0.0 || behind > P.DepthParams.x) return;
    vec2 texel = 1.0 / vec2(textureSize(uTextures[nonuniformEXT(P.DepthInfo.x)], 0));
    vec3 n = normalize(cross(DepthWorld(P, uv + vec2(texel.x, 0.0)) - surface, DepthWorld(P, uv + vec2(0.0, texel.y)) - surface));
    // Face the camera: against the view ray through this pixel.
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    vec4 nearP = P.DepthInvViewProj * vec4(ndc, 0.0, 1.0), farP = P.DepthInvViewProj * vec4(ndc, 1.0, 1.0);
    if (dot(n, farP.xyz / farP.w - nearP.xyz / nearP.w) > 0.0) n = -n;
    // Only particles moving into the visible side bounce: one coming from behind (under a slab whose top the camera
    // sees) carries on, rather than being pushed through to the far side.
    vec3 v = mat3(P.SimToWorld) * p.VelLife.xyz;
    float vn = dot(v, n);
    if (vn >= 0.0) return;
    vec3 normalPart = n * vn, tangent = v - normalPart;
    v = tangent * (1.0 - P.Collision.w) - normalPart * P.Collision.z;
    p.VelLife.w -= p.VelLife.w * clamp(P.Misc.x, 0.0, 1.0);
    p.VelLife.xyz = mat3(P.WorldToSim) * v;
    p.PosAge.xyz = (P.WorldToSim * vec4(surface + n * P.DepthParams.y, 1.0)).xyz;
}

// Collision with the 3D colliders listed in the parameters: a particle inside one (by its collision radius) moves out
// along the nearest surface's normal, and its velocity into it bounces (Bounce) and its sliding slows (Dampen).
void ColliderCollide(GpuParticleParamsRef P, inout GpuParticle p)
{
    uint count = min(P.ColliderCount.x, uint(PARTICLE_COLLIDERS));
    if (count == 0u) return;
    vec3 wp = (P.SimToWorld * vec4(p.PosAge.xyz, 1.0)).xyz;
    vec3 v = mat3(P.SimToWorld) * p.VelLife.xyz;
    float radius = P.DepthParams.y;
    bool hit = false;
    for (uint i = 0u; i < count; ++i)
    {
        vec4 a = P.Colliders[i * 4u], b = P.Colliders[i * 4u + 1u], c = P.Colliders[i * 4u + 2u], d = P.Colliders[i * 4u + 3u];
        int type = int(a.w + 0.5);
        vec3 n = vec3(0.0, 1.0, 0.0);
        float depth = -1.0;
        if (type == 1)
        {
            vec3 rel = wp - a.xyz;
            vec3 local = vec3(dot(rel, b.xyz), dot(rel, c.xyz), dot(rel, d.xyz));
            vec3 extent = vec3(b.w, c.w, d.w) + radius;
            vec3 room = extent - abs(local);
            if (all(greaterThan(room, vec3(0.0))))
            {
                // Out through the nearest face.
                if (room.x <= room.y && room.x <= room.z) { depth = room.x; n = b.xyz * sign(local.x); }
                else if (room.y <= room.z) { depth = room.y; n = c.xyz * sign(local.y); }
                else { depth = room.z; n = d.xyz * sign(local.z); }
            }
        }
        else
        {
            vec3 center = a.xyz;
            if (type == 2) center += c.xyz * clamp(dot(wp - a.xyz, c.xyz), -c.w, c.w);
            vec3 rel = wp - center;
            float len = length(rel);
            depth = b.w + radius - len;
            n = len > 1e-6 ? rel / len : vec3(0.0, 1.0, 0.0);
        }
        if (depth <= 0.0) continue;
        wp += n * depth;
        float vn = dot(v, n);
        if (vn < 0.0)
        {
            vec3 normalPart = n * vn;
            v = (v - normalPart) * (1.0 - P.Collision.w) - normalPart * P.Collision.z;
            hit = true;
        }
    }
    if (hit) p.VelLife.w -= p.VelLife.w * clamp(P.Misc.x, 0.0, 1.0);
    p.PosAge.xyz = (P.WorldToSim * vec4(wp, 1.0)).xyz;
    p.VelLife.xyz = mat3(P.WorldToSim) * v;
}

void Integrate(GpuParticleParamsRef P, inout GpuParticle p)
{
    float dt = P.Spin.w;
    p.PosAge.w += dt;
    float life = clamp(p.PosAge.w / p.VelLife.w, 0.0, 1.0);
    vec4 curves = SampleCurveLut(P, life);
    vec3 accel = P.Gravity.xyz;
    if (P.Gravity.w > 0.5) accel += P.Force.xyz * curves.z;
    p.VelLife.xyz = (p.VelLife.xyz + accel * dt) * max(0.0, 1.0 - P.Spin.z * dt);
    vec3 previous = p.PosAge.xyz;
    p.PosAge.xyz += p.VelLife.xyz * curves.y * dt;
    p.Misc.y += p.Misc.z * dt;
    if (P.Noise.z > 0.5 && P.Noise.x != 0.0)
    {
        vec3 wp = (P.SimToWorld * vec4(p.PosAge.xyz, 1.0)).xyz;
        vec3 drift = CurlNoise(wp * P.Noise.y + vec3(0.0, 0.0, P.Box.w)) * P.Noise.x;
        p.PosAge.xyz += mat3(P.WorldToSim) * drift * dt;
    }
    if (P.Collision.x < 0.5) return;
    if (P.Collision.x > 1.5)
    {
        DepthCollide(P, p);
        return;
    }

    // Plane collision (world Y).
    vec3 from = (P.SimToWorld * vec4(previous, 1.0)).xyz, to = (P.SimToWorld * vec4(p.PosAge.xyz, 1.0)).xyz;
    float plane = P.Collision.y;
    if (to.y >= plane) return;
    vec3 hitPoint = vec3(to.x, plane, to.z);
    if (from.y >= plane - 1e-4)
    {
        float t = (from.y - plane) / max(from.y - to.y, 1e-6);
        hitPoint = mix(from, to, clamp(t, 0.0, 1.0));
        hitPoint.y = plane;
    }
    vec3 v = mat3(P.SimToWorld) * p.VelLife.xyz;
    if (v.y < 0.0)
    {
        vec3 normalPart = vec3(0.0, v.y, 0.0), tangent = v - normalPart;
        v = tangent * (1.0 - P.Collision.w) - normalPart * P.Collision.z;
    }
    p.VelLife.xyz = mat3(P.WorldToSim) * v;
    p.PosAge.xyz = (P.WorldToSim * vec4(hitPoint, 1.0)).xyz;
    p.VelLife.w -= p.VelLife.w * clamp(P.Misc.x, 0.0, 1.0);
}

void main()
{
    GpuParticleParamsRef P = GpuParticleParamsRef(pc.Params);
    uint capacity = P.Counts.x;
    uint i = gl_GlobalInvocationID.x;
    if (i >= capacity) return;
    GpuParticlesRef particles = GpuParticlesRef(pc.Particles);
    uint offset = (i + capacity - P.Counts.y % capacity) % capacity; // position after the ring head
    if (offset < P.Counts.z)
    {
        g_Rng = i * 1973u + P.Counts.w * 9277u + 26699u;
        Random01();
        particles.Items[i] = Emit(P, offset);
        if (P.Trail.x > 0.5)
        {
            GpuTrailRef trail = GpuTrailRef(P.TrailBuffer.xy);
            for (uint k = 0u; k < TRAIL_POINTS; ++k) trail.Points[i * TRAIL_POINTS + k] = vec4(0.0, 0.0, 0.0, -1.0);
        }
        return;
    }
    GpuParticle p = particles.Items[i];
    if (!ParticleAlive(p) || P.Spin.w <= 0.0) return;
    Integrate(P, p);
    ColliderCollide(P, p);
    particles.Items[i] = p;
    if (P.Trail.x > 0.5)
    {
        // Records the position every interval (and at once the first time), pushing the older points back.
        GpuTrailRef trail = GpuTrailRef(P.TrailBuffer.xy);
        uint base = i * TRAIL_POINTS;
        float last = trail.Points[base].w;
        if (last < 0.0 || p.PosAge.w - last >= P.Trail.y)
        {
            for (uint k = TRAIL_POINTS - 1u; k > 0u; --k) trail.Points[base + k] = trail.Points[base + k - 1u];
            trail.Points[base] = vec4(p.PosAge.xyz, p.PosAge.w);
        }
    }
}
