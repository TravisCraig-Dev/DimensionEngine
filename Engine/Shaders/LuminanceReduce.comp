#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_nonuniform_qualifier : require

// Auto exposure: the HDR image reduced to a grid of cells, each the average log2 luminance of its samples (written to
// a buffer the CPU reads back a few frames later and averages; see SceneRenderer::UpdateAutoExposure).
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uTextures[];
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer CellsOut { float Cells[]; };

layout(push_constant) uniform Push
{
    uvec2 Out;      // CellsOut address
    uint Hdr;       // bindless HDR texture
    uint CellSize;  // pixels per cell side
    uvec2 Grid;     // cells across and down
    uvec2 Size;     // HDR texture size
} pc;

void main()
{
    uvec2 cell = gl_GlobalInvocationID.xy;
    if (cell.x >= pc.Grid.x || cell.y >= pc.Grid.y) return;
    uvec2 start = cell * pc.CellSize;
    uint step = max(pc.CellSize / 8u, 1u); // about 64 samples per cell
    float sum = 0.0;
    uint count = 0u;
    for (uint y = 0u; y < pc.CellSize; y += step)
        for (uint x = 0u; x < pc.CellSize; x += step)
        {
            uvec2 p = min(start + uvec2(x, y), pc.Size - 1u);
            vec3 c = texelFetch(uTextures[nonuniformEXT(pc.Hdr)], ivec2(p), 0).rgb;
            float lum = dot(c, vec3(0.2126, 0.7152, 0.0722));
            sum += log2(max(lum, 1e-5));
            ++count;
        }
    CellsOut(pc.Out).Cells[cell.y * pc.Grid.x + cell.x] = count > 0u ? sum / float(count) : -16.0;
}
