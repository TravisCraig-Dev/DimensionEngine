#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

// A terrain's grass field: one tuft per cell of a grid anchored to the terrain (so tufts stay put as the camera moves)
// over the square around the camera, each kept as often as the terrain's grass density there says, thinning toward
// the field's edge (the survivors grow a little to cover for the missing), set on the ground, left out on steep slopes
// and outside the view; the kept ones are appended to an instance buffer (MeshInstance) that an indirect draw renders.
// The sun's shadow cascades run it again with their own frustums (the same tufts: the thinning goes by the camera).

layout(local_size_x = 8, local_size_y = 8) in;

struct MeshInstance
{
    mat4 Model;
    uvec4 Data; // x: entity id, yz: tint (half floats, Flags bit 17), w: motion (sway, bending)
};
layout(buffer_reference, std430, buffer_reference_align = 16) writeonly buffer InstancesRef { MeshInstance Items[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer CounterRef { uint Count; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer HeightsRef { float Heights[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer DensityRef { uint Packed[]; }; // 4 samples a uint

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer ParamsRef
{
    mat4 TerrainToWorld;
    vec4 Frustum[6];   // world-space planes (xyz normal pointing in, w)
    vec4 Camera;       // xyz: the camera in the terrain's space, w: the field's reach (terrain units)
    vec4 Terrain;      // xy: size, z: samples a side, w: world units per terrain unit (for the cull radius)
    vec4 Grid;         // xy: the first cell, z: cells a side, w: cell size
    vec4 Look;         // x, y: min and max scale, z: the flattest the ground must be (normal's y), w: seed
    vec4 Mesh;         // x: the tuft's radius, y: its middle's height (both at scale 1), z: tint variation
    uvec4 Sources;     // xy: heights (a float per sample), zw: grass density (a byte per sample)
    uvec4 Out;         // xy: instances, zw: counter
    uvec4 Info;        // x: capacity, y: entity id, z: motion
};

layout(push_constant) uniform Push
{
    uvec2 Params;
} pc;

uint Hash(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float Rand(inout uint state)
{
    state = Hash(state + 0x9e3779b9u);
    return float(state >> 8) * (1.0 / 16777216.0);
}

float HeightAt(HeightsRef h, int n, vec2 size, vec2 xz)
{
    vec2 f = clamp((xz / size + 0.5) * float(n - 1), vec2(0.0), vec2(float(n - 1)));
    int c0 = min(int(f.x), n - 2), r0 = min(int(f.y), n - 2);
    float tx = f.x - float(c0), tz = f.y - float(r0);
    float a = h.Heights[r0 * n + c0], b = h.Heights[r0 * n + c0 + 1], c = h.Heights[(r0 + 1) * n + c0], d = h.Heights[(r0 + 1) * n + c0 + 1];
    // the same split as the terrain's mesh: (c0, r0) -> (c0 + 1, r0 + 1)
    if (tx >= tz) return a + (b - a) * tx + (d - b) * tz;
    return a + (c - a) * tz + (d - c) * tx;
}

float DensityAt(DensityRef dens, int n, vec2 size, vec2 xz)
{
    vec2 f = clamp((xz / size + 0.5) * float(n - 1), vec2(0.0), vec2(float(n - 1)));
    int c0 = min(int(f.x), n - 2), r0 = min(int(f.y), n - 2);
    vec2 t = f - vec2(c0, r0);
    float v[4];
    for (int k = 0; k < 4; ++k)
    {
        int i = (r0 + (k >> 1)) * n + c0 + (k & 1);
        v[k] = float((dens.Packed[i >> 2] >> ((i & 3) * 8)) & 255u) / 255.0;
    }
    return mix(mix(v[0], v[1], t.x), mix(v[2], v[3], t.x), t.y);
}

void main()
{
    ParamsRef P = ParamsRef(pc.Params);
    uint side = uint(P.Grid.z);
    uvec2 g = gl_GlobalInvocationID.xy;
    if (g.x >= side || g.y >= side) return;
    ivec2 cell = ivec2(P.Grid.xy) + ivec2(g);
    float cellSize = P.Grid.w;
    vec2 size = P.Terrain.xy;
    int n = int(P.Terrain.z);
    uint state = Hash(uint(cell.x) * 73856093u ^ uint(cell.y) * 19349663u ^ floatBitsToUint(P.Look.w));
    vec2 xz = -size * 0.5 + (vec2(cell) + vec2(Rand(state), Rand(state))) * cellSize;
    if (any(greaterThan(abs(xz), size * 0.5))) return;
    float reach = P.Camera.w;
    float d = distance(xz, P.Camera.xz);
    if (d > reach) return;
    // Thinner toward the edge (a third kept there), each survivor larger to cover for the gaps, shrinking away at the end.
    float far = smoothstep(0.35 * reach, reach, d);
    float keep = mix(1.0, 0.33, far);
    DensityRef dens = DensityRef(P.Sources.zw);
    if (Rand(state) >= DensityAt(dens, n, size, xz) * keep) return;
    HeightsRef h = HeightsRef(P.Sources.xy);
    float y = HeightAt(h, n, size, xz);
    float step = max(size.x, size.y) / float(max(n - 1, 1));
    float dx = HeightAt(h, n, size, xz + vec2(step, 0.0)) - HeightAt(h, n, size, xz - vec2(step, 0.0));
    float dz = HeightAt(h, n, size, xz + vec2(0.0, step)) - HeightAt(h, n, size, xz - vec2(0.0, step));
    float up = 2.0 * step / length(vec3(dx, 2.0 * step, dz));
    if (up < P.Look.z) return;
    // (shrinking over the last 40%: no line where the field ends)
    float scale = mix(P.Look.x, P.Look.y, Rand(state)) * mix(1.0, 1.45, far) * (1.0 - smoothstep(0.6 * reach, reach, d));
    float yaw = Rand(state) * 6.2831853;
    // Outside the view: left out (a sphere about the tuft, its sway included).
    vec3 middle = (P.TerrainToWorld * vec4(xz.x, y + P.Mesh.y * scale, xz.y, 1.0)).xyz;
    float radius = (P.Mesh.x * scale + 0.3) * P.Terrain.w;
    for (int i = 0; i < 6; ++i)
        if (dot(P.Frustum[i].xyz, middle) + P.Frustum[i].w < -radius) return;
    uint index = atomicAdd(CounterRef(P.Out.zw).Count, 1u);
    if (index >= P.Info.x) return;
    float c = cos(yaw), s = sin(yaw);
    mat4 local = mat4(vec4(c * scale, 0.0, -s * scale, 0.0), vec4(0.0, scale, 0.0, 0.0), vec4(s * scale, 0.0, c * scale, 0.0),
                      vec4(xz.x, y, xz.y, 1.0));
    // A little variety: lighter and darker, greener and yellower tufts.
    float bright = 1.0 + (Rand(state) - 0.5) * 2.0 * P.Mesh.z;
    float warm = (Rand(state) - 0.5) * 2.0 * P.Mesh.z;
    vec3 tint = bright * vec3(1.0 + 0.6 * warm, 1.0, 1.0 - 0.8 * warm);
    InstancesRef(P.Out.xy).Items[index] = MeshInstance(P.TerrainToWorld * local,
        uvec4(P.Info.y, packHalf2x16(tint.xy), packHalf2x16(vec2(tint.z, 1.0)), P.Info.z));
}
