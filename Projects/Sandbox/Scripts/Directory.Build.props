<Project>
  <!-- Generated by the Dimension editor; do not edit. -->
  <PropertyGroup>
    <DimensionManagedDir>C:\Users\travi\RiderProjects\DimensionEngine\out\build\release\bin\managed</DimensionManagedDir>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\.dimension\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <!-- The engine's checks of scripts (DIM001...: callbacks never called, containers not disposed, engine use in jobs). -->
