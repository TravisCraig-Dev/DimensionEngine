    <Analyzer Include="$(DimensionManagedDir)\Dimension.Analyzers.CodeFixes.dll" Condition="Exists('$(DimensionManagedDir)\Dimension.Analyzers.CodeFixes.dll')" />
  </ItemGroup>
</Project>
